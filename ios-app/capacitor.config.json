{
  "appId": "pl.gdzieponiesie.azimo",
  "appName": "Azimo",
  "webDir": "www",
  "server": {
    "url": "https://gdzieponiesie.pl/gps/",
    "allowNavigation": [
      "gdzieponiesie.pl",
      "*.gdzieponiesie.pl",
      "*.workers.dev",
      "tiles.openfreemap.org",
      "unpkg.com",
      "fonts.googleapis.com",
      "fonts.gstatic.com"
    ],
    "errorPath": "error.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#16181D",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "plugins": {
    "BackgroundGeolocation": {},
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#16181D",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}